@{
    ViewData["Title"] = "Dashboard";
}

<h1 style="margin-bottom:20px;">🏥 Hospital Management Dashboard</h1>
<hr />

<div style="display:grid; grid-template-columns:1fr 1fr; gap:25px; max-width:900px;">

    @* Patients – Admin + Doctor *@
    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
    {
        <a asp-controller="Patient" asp-action="Index" class="card-link">
            <div class="card">
                👨‍⚕️ <strong>Patients</strong>
            </div>
        </a>
    }

    @* Doctors – Admin only *@
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Doctor" asp-action="Index" class="card-link">
            <div class="card">
                🩺 <strong>Doctors</strong>
            </div>
        </a>
    }

    @* Appointments – Admin + Doctor *@
    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
    {
        <a asp-controller="Appointment" asp-action="Index" class="card-link">
            <div class="card">
                📅 <strong>Appointments</strong>
            </div>
        </a>
    }

    @* Billing – Admin only *@
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Bill" asp-action="Index" class="card-link">
            <div class="card">
                💳 <strong>Billing</strong>
            </div>
        </a>
    }

</div>

<style>
    .card-link {
        text-decoration: none;
        color: inherit;
    }

    .card {
        padding: 35px;
        border-radius: 12px;
        background: #f8f9fa;
        text-align: center;
        font-size: 20px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.08);
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .card:hover {
            transform: translateY(-5px);
            background: #eef4ff;
        }
</style>
